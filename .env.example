# ============================================================
# Modo SERVIDOR (Node + SQLite) — desarrollo local / self-host
# ============================================================
# Puerto del servidor (por defecto 3000).
PORT=3000
# Carpeta persistente de la base de datos SQLite. Si no se define, usa <cwd>/.data
DATA_DIR=/data
NODE_ENV=production

# ============================================================
# Modo ESTÁTICO (GitHub Pages + Supabase)
# ============================================================
# Credenciales públicas del proyecto Supabase (las inyecta el build del cliente).
# Cuando están presentes, la app usa Supabase como backend (en vez de /api).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...tu_anon_key

# Ruta base en GitHub Pages: /<nombre-del-repo>
NEXT_PUBLIC_BASE_PATH=/flota-horarios

# Solo para sembrar Supabase (scripts/seed_supabase.mjs). NO lo publiques.
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role_key
